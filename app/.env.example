# NutriVision backend — env vars. Copy to `.env` (gitignored).

# Path to the JSON file backing the in-memory state store.
STATE_PATH=app/state.json

# Open Food Facts base URL (free, no key required).
OFF_BASE_URL=https://world.openfoodfacts.org

# Set to "true" to enable Tesseract OCR as a fallback when the vision
# stub can't find a canned match for `image_ref`. Requires the
# `pytesseract` Python package AND the Tesseract binary on the system
# path (`brew install tesseract` on macOS, `apt install tesseract-ocr`
# on Debian).
OCR_ENABLED=false

# ── Cut (b): vision pipeline (optional — fallback to canned when unset) ─
# Google AI Studio — free tier, sign up at https://aistudio.google.com/apikey
# Primary vision provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud — fast vision inference & automatic cascade fallback.
# Sign up at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter — resilient AI Coach fallback cascade.
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Fallback model ID or smart auto-routing (defaults to "openrouter/auto" if unset)
OPENROUTER_FALLBACK_MODEL=openrouter/auto

# HuggingFace Inference Router — free tier, sign up at https://huggingface.co/settings/tokens
# When unset, the HF validator stage reports `fallback`.
HF_API_TOKEN=
HF_FOOD_MODEL=nateraw/food

# ── Cut (b): nutrition cascade (optional — cascade steps skip when unset) ─
# USDA FoodData Central. DEMO_KEY works without signup but is rate-limited;
# grab a real key at https://api.nal.usda.gov/ui/key.html for higher quotas.
USDA_API_KEY=DEMO_KEY

# Fruityvice — fruit-nutrition lookup (free, no key required).
FRUITYVICE_BASE_URL=https://www.fruityvice.com/api

# ── Cut (b): caches ────────────────────────────────────────────────────
# Stdlib sqlite3 cache for exact-match nutrition lookups + the vision
# pipeline's per-image result.
SQLITE_CACHE_PATH=app/cache/cache.db

# ChromaDB persistent cache for image-id → detected-items lookups.
# In cut (b) we use string-id match; cut (c) will add CLIP embeddings.
CHROMA_CACHE_PATH=app/cache/chroma

# TTLs (in seconds). Defaults: 7d vision, 1d nutrition.
VISION_CACHE_TTL=604800
NUTRITION_CACHE_TTL=86400

# ── Google OAuth 2.0 & Admin Telemetry ─────────────────────────────────
# Google OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Comma-separated list of admin email addresses allowed to view telemetry dashboard
# Example: ADMIN_EMAILS=yourname@gmail.com,colleague@company.com
ADMIN_EMAILS=

# Secret key used for signing session JWTs (generate 32+ char random string)
JWT_SECRET=nutrivision-secure-jwt-secret-key-prod-v1
