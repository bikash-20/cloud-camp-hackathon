# Frontend env vars (read at build time by Vite).
#
# Copy to `.env` for local dev, or set in Vercel → Project Settings →
# Environment Variables. All vars must be prefixed with VITE_ to be
# exposed to the browser bundle.
#
# VITE_API_BASE — base URL of the FastAPI backend.
#   Local dev: http://localhost:8000
#   Production: set to your Render service URL in Vercel, e.g.
#               VITE_API_BASE=https://your-service.onrender.com
#
VITE_API_BASE=http://localhost:8000

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# e.g. 123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
