# Frontend env vars (read at build time by Vite).
#
# Copy to `.env` for local dev, or set in Vercel → Project Settings →
# Environment Variables. All vars must be prefixed with VITE_ to be
# exposed to the browser bundle.
#
# VITE_API_BASE — base URL of the FastAPI backend.
#   Local dev: leave empty (falls back to http://localhost:8000)
#   Production: set to your Railway / Render / Fly URL, e.g.
#               VITE_API_BASE=https://nutrivision-api.up.railway.app
#
# To run on the canned mock fixtures (no backend at all):
#   VITE_API_BASE=""
VITE_API_BASE=
